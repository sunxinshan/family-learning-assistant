FLA_ENVIRONMENT=development
FLA_DATABASE_URL=sqlite:///./data/dev.db
FLA_LOG_LEVEL=INFO
FLA_LOG_FORMAT=json
FLA_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
FLA_ACCESS_TOKEN_MINUTES=30
FLA_REFRESH_TOKEN_DAYS=30
FLA_SEED_DEMO_DATA=true
FLA_MASTERY_THRESHOLD=2
FLA_REVIEW_INTERVALS_DAYS=[1,3,7,14]
FLA_CHECKPOINT_BACKEND=sqlite
FLA_CHECKPOINT_SQLITE_PATH=./data/checkpoints.db
FLA_CHECKPOINT_URL=
FLA_PROMPT_DIR=./app/modules/agent/prompts
FLA_LLM_PROVIDER=mock
FLA_LLM_BASE_URL=https://api.openai.com/v1
FLA_LLM_API_KEY=
FLA_LLM_MODEL=gpt-4.1-mini
FLA_LLM_TIMEOUT_SECONDS=45
FLA_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
